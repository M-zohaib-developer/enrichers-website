{
  "name": "enrichers-candidate-a-redesign",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint . && npm run lint:colors",
    "lint:colors": "node scripts/check-hardcoded-colors.mjs",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "db:inspect": "tsx scripts/inspect-db.mjs",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "migrate:fresh": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:fresh",
    "seed:globals": "tsx scripts/seed-globals.ts",
    "seed:logo": "tsx scripts/seed-logo.ts",
    "seed:home": "tsx scripts/seed-home.ts",
    "seed:stock-broking": "tsx scripts/seed-stock-broking.ts",
    "seed:commodity-brokerage": "tsx scripts/seed-commodity-brokerage.ts",
    "seed:open-account": "tsx scripts/seed-open-account.ts",
    "seed:contact-us": "tsx scripts/seed-contact-us.ts",
    "seed:mt5-app": "tsx scripts/seed-mt5-app.ts",
    "seed:faqs": "tsx scripts/seed-faqs.ts",
    "seed:business-brokerage": "tsx scripts/seed-business-brokerage.ts",
    "seed:arid-land-development": "tsx scripts/seed-arid-land-development.ts",
    "seed:agriculture": "tsx scripts/seed-agriculture.ts",
    "seed:about-us": "tsx scripts/seed-about-us.ts",
    "seed:articles": "tsx scripts/seed-articles.ts",
    "seed:enrichers-team": "tsx scripts/seed-enrichers-team.ts",
    "seed:team-member-profile": "tsx scripts/seed-team-member-profile.ts",
    "seed:strategic-partner-hero": "tsx scripts/seed-strategic-partner-hero.ts",
    "seed:strategic-partner-programme": "tsx scripts/seed-strategic-partner-programme.ts",
    "seed:strategic-partner-explorer": "tsx scripts/seed-strategic-partner-explorer.ts",
    "seed:strategic-partner-consultation": "tsx scripts/seed-strategic-partner-consultation.ts",
    "seed:latest-insight-hero": "tsx scripts/seed-latest-insight-hero.ts",
    "seed:latest-insight-library": "tsx scripts/seed-latest-insight-library.ts",
    "seed:regulation": "tsx scripts/seed-regulation.ts",
    "seed:missing-pages": "tsx scripts/seed-missing-pages.ts",
    "setup:globals": "tsx scripts/reset-globals-schema.mjs && tsx scripts/seed-globals.ts",
    "verify:editing": "tsx scripts/verify-editing.ts",
    "verify:migrations": "tsx scripts/verify-migrations.ts",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "start:available": "node scripts/start-available-port.mjs",
    "test": "pnpm run test:int && pnpm run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "seed:research-centre-hero": "tsx scripts/seed-research-centre-hero.ts",
    "seed:research-centre-consultation": "tsx scripts/seed-research-centre-consultation.ts",
    "seed:tourism-hero": "tsx scripts/seed-tourism-hero.ts",
    "seed:tourism-consultation": "tsx scripts/seed-tourism-consultation.ts",
    "seed:tourism-content": "tsx scripts/seed-tourism-content.ts",
    "seed:skardu-hotel": "tsx scripts/seed-skardu-hotel.ts",
    "seed:tourism-hospitality": "tsx scripts/seed-tourism-hospitality.ts",
    "seed:careers": "tsx scripts/seed-careers.ts",
    "publish:pages": "tsx scripts/publish-all-pages.ts",
    "verify:drafts": "tsx scripts/verify-drafts.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/live-preview-react": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/plugin-form-builder": "^3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@tailwindcss/postcss": "^4.1.18",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^1.62.0",
    "next": "16.3.3",
    "payload": "3.88.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.71.1",
    "sharp": "0.34.2",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "jsdom": "28.0.0",
    "prettier": "^3.4.2",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
